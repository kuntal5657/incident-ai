# ================================
# OpenAI Configuration
# ================================

# OpenAI API key (DO NOT commit the real value)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Default base model (used before fine-tuning is applied)
OPENAI_BASE_MODEL=gpt-4.1-mini

# Fine-tuned model name (will be populated later)
OPENAI_FINE_TUNED_MODEL=

# Request timeout in seconds
OPENAI_TIMEOUT_SECONDS=15

# Hard token budget per request (safety + cost control)
OPENAI_MAX_TOKENS=800

# ================================
# Environment
# ================================

ENVIRONMENT=local
